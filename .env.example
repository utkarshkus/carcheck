# Copy to .env for local dev. On Netlify, set these under
# Site settings > Environment variables. Never commit the real values.

# Required. The chat function reads this server side only.
OPENAI_API_KEY=sk-replace-me

# Optional overrides
OPENAI_MODEL=gpt-4o
CHAT_DAILY_LIMIT_PER_IP=20
CHAT_BURST_LIMIT_PER_MIN=4
CHAT_MAX_OUTPUT_TOKENS=700
